# Скопируйте в .env.local и подставьте значения из своего проекта Supabase
# (Project Settings → API). Ключ anon публичный: он попадает в собранный
# JavaScript, и это нормально — доступ к данным ограничен политиками RLS.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=ваш-anon-ключ
