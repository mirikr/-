# Скопируйте в .env.local и подставьте значения из своего проекта Supabase
# (Project Settings → API).
#
# Нужен ПУБЛИЧНЫЙ ключ: sb_publishable_... (в старых проектах — anon public,
# строка вида eyJ...). Он попадает в собранный JavaScript, и это нормально:
# доступ к данным ограничивает политика RLS, а не секретность ключа.
#
# Ключ sb_secret_... (он же service_role) сюда класть нельзя никогда — он
# обходит RLS и открывает данные всех пользователей проекта.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ваш-публичный-ключ
